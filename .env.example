PORT=4317
# Opcionales: también puedes ingresarlas en Ajustes (solo durante la sesión).
ELEVENLABS_API_KEY=
YOUTUBE_API_KEY=
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=
KICK_ACCESS_TOKEN=
# Confirma que registraste https://tu-dominio/webhooks/kick en tu app de Kick.
KICK_WEBHOOK_READY=false
# Opcional para el conector no oficial de TikTok:
EULER_API_KEY=

# Fish Audio: voces del catálogo público (necesita clave propia)
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
# Opcional: ruta de Python con edge-tts instalado
# EDGE_TTS_PYTHON=
# Opcional: carpeta del perfil de voz local (clonación de tu propia voz)
# LOCAL_VOICE_PROFILE=

# Personajes locales sin API: Windows usa el motor activado dentro de la carpeta.
# En Mac Apple Silicon, configura un entorno mlx-audio y su cache de pesos:
# OFFLINE_TTS_ENGINE=mlx
# OFFLINE_TTS_PYTHON=
# OFFLINE_TTS_CACHE=
